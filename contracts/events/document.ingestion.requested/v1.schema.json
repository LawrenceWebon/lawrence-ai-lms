{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-lms.local/events/document.ingestion.requested/v1.schema.json",
  "title": "document.ingestion.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_type", "event_version", "producer", "tenant_id",
    "aggregate_type", "aggregate_id", "source_document_id", "source_version_id",
    "ingestion_run_id", "aggregate_version", "occurred_at", "recorded_at",
    "correlation_id", "causation_id", "privacy_class", "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "document.ingestion.requested.v1"},
    "event_version": {"const": 1},
    "producer": {"const": "documents"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "aggregate_type": {"const": "document_ingestion_run"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "source_document_id": {"type": "string", "format": "uuid"},
    "source_version_id": {"type": "string", "format": "uuid"},
    "ingestion_run_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": "string", "format": "uuid"},
    "privacy_class": {"const": "internal"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "checkpoint", "reason_code", "input_manifest_sha256",
        "output_manifest_sha256", "attempt_count"
      ],
      "properties": {
        "status": {"const": "queued"},
        "checkpoint": {"const": "created"},
        "reason_code": {"type": "null"},
        "input_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "output_manifest_sha256": {"type": "null"},
        "attempt_count": {"const": 0}
      }
    }
  }
}
