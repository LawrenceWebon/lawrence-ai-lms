{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-lms.local/events/course_generation.canonicalized/v1.schema.json",
  "title": "course_generation.canonicalized.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "producer",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "source_document_id",
    "source_version_id",
    "ingestion_run_id",
    "course_generation_run_id",
    "aggregate_version",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "privacy_class",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "course_generation.canonicalized.v1"},
    "event_version": {"const": 1},
    "producer": {"const": "course_generation"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "aggregate_type": {"const": "course_generation_run"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "source_document_id": {"type": "string", "format": "uuid"},
    "source_version_id": {"type": "string", "format": "uuid"},
    "ingestion_run_id": {"type": "string", "format": "uuid"},
    "course_generation_run_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": "string", "format": "uuid"},
    "privacy_class": {"const": "internal"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkpoint",
        "course_generation_canonicalization_id",
        "course_id",
        "course_version_id",
        "reviewed_output_sha256",
        "canonical_content_sha256",
        "canonicalization_sha256"
      ],
      "properties": {
        "status": {"const": "canonicalized"},
        "checkpoint": {"const": "canonicalized"},
        "course_generation_canonicalization_id": {
          "type": "string",
          "format": "uuid"
        },
        "course_id": {"type": "string", "format": "uuid"},
        "course_version_id": {"type": "string", "format": "uuid"},
        "reviewed_output_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "canonical_content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "canonicalization_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
