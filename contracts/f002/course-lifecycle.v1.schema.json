{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-lms.local/f002/course-lifecycle.v1.schema.json",
  "title": "F-002 course lifecycle public DTO example suite v1",
  "description": "The top-level object validates the committed example suite. Each named public HTTP DTO is independently addressable through its $defs fragment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "CreateCourseV1",
    "UpdateCourseVersionV1",
    "ReplaceCurriculumV1",
    "TransitionCourseVersionV1",
    "CourseSnapshotV1",
    "CourseVersionHistoryV1",
    "CreateSuccessorDraftV1",
    "SuccessorDraftResultV1"
  ],
  "properties": {
    "CreateCourseV1": { "$ref": "#/$defs/CreateCourseV1" },
    "UpdateCourseVersionV1": { "$ref": "#/$defs/UpdateCourseVersionV1" },
    "ReplaceCurriculumV1": { "$ref": "#/$defs/ReplaceCurriculumV1" },
    "TransitionCourseVersionV1": { "$ref": "#/$defs/TransitionCourseVersionV1" },
    "CourseSnapshotV1": { "$ref": "#/$defs/CourseSnapshotV1" },
    "CourseVersionHistoryV1": { "$ref": "#/$defs/CourseVersionHistoryV1" },
    "CreateSuccessorDraftV1": { "$ref": "#/$defs/CreateSuccessorDraftV1" },
    "SuccessorDraftResultV1": { "$ref": "#/$defs/SuccessorDraftResultV1" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "nullable_uuid": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "course_status": {
      "enum": [
        "draft",
        "under_review",
        "changes_requested",
        "approved",
        "scheduled",
        "published",
        "withdrawn",
        "archived"
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 63
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "maxLength": 10
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "identity_pair": {
      "oneOf": [
        { "required": ["id", "expected_row_version"] },
        {
          "not": {
            "anyOf": [
              { "required": ["id"] },
              { "required": ["expected_row_version"] }
            ]
          }
        }
      ]
    },
    "CreateCourseV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "primary_locale", "title", "description"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "primary_locale": { "$ref": "#/$defs/locale" },
        "title": { "$ref": "#/$defs/title" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "UpdateCourseVersionV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "required": ["expected_version_row_version"],
      "properties": {
        "expected_version_row_version": { "type": "integer", "minimum": 1 },
        "primary_locale": { "$ref": "#/$defs/locale" },
        "title": { "$ref": "#/$defs/title" },
        "description": { "$ref": "#/$defs/description" }
      },
      "anyOf": [
        { "required": ["primary_locale"] },
        { "required": ["title"] },
        { "required": ["description"] }
      ]
    },
    "curriculum_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position", "document"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "expected_row_version": { "type": "integer", "minimum": 1 },
        "kind": { "const": "rich_text" },
        "position": { "type": "integer", "minimum": 1 },
        "document": {
          "$ref": "https://contracts.ai-lms.local/f002/canonical-course.v1.schema.json#/$defs/rich_text_document"
        }
      },
      "allOf": [{ "$ref": "#/$defs/identity_pair" }]
    },
    "curriculum_lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "position", "is_required", "content_blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "expected_row_version": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/title" },
        "position": { "type": "integer", "minimum": 1 },
        "is_required": { "type": "boolean" },
        "content_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/curriculum_block" }
        }
      },
      "allOf": [{ "$ref": "#/$defs/identity_pair" }]
    },
    "curriculum_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "position", "lessons"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "expected_row_version": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/title" },
        "position": { "type": "integer", "minimum": 1 },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/curriculum_lesson" }
        }
      },
      "allOf": [{ "$ref": "#/$defs/identity_pair" }]
    },
    "ReplaceCurriculumV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_version_row_version", "sections"],
      "properties": {
        "expected_version_row_version": { "type": "integer", "minimum": 1 },
        "sections": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/curriculum_section" }
        }
      }
    },
    "TransitionCourseVersionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition",
        "expected_version_row_version",
        "expected_content_hash"
      ],
      "properties": {
        "transition": {
          "enum": [
            "submit_review",
            "request_changes",
            "approve",
            "publish",
            "withdraw",
            "archive"
          ]
        },
        "expected_version_row_version": { "type": "integer", "minimum": 1 },
        "expected_course_row_version": { "type": "integer", "minimum": 1 },
        "expected_content_hash": { "$ref": "#/$defs/hash" },
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reason_code" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "transition": { "const": "request_changes" } },
            "required": ["transition"]
          },
          "then": {
            "required": ["reason_codes"],
            "not": { "required": ["reason_code"] }
          },
          "else": { "not": { "required": ["reason_codes"] } }
        },
        {
          "if": {
            "properties": {
              "transition": { "enum": ["withdraw", "archive"] }
            },
            "required": ["transition"]
          },
          "then": { "required": ["reason_code"] },
          "else": { "not": { "required": ["reason_code"] } }
        },
        {
          "if": {
            "properties": {
              "transition": { "enum": ["publish", "withdraw"] }
            },
            "required": ["transition"]
          },
          "then": { "required": ["expected_course_row_version"] },
          "else": {
            "not": { "required": ["expected_course_row_version"] }
          }
        }
      ]
    },
    "CourseSnapshotV1": {
      "$ref": "https://contracts.ai-lms.local/f002/canonical-course.v1.schema.json"
    },
    "course_version_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "course_id",
        "predecessor_version_id",
        "version_number",
        "status",
        "title",
        "content_hash",
        "row_version",
        "is_current_published"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "tenant_id": { "$ref": "#/$defs/uuid" },
        "course_id": { "$ref": "#/$defs/uuid" },
        "predecessor_version_id": { "$ref": "#/$defs/nullable_uuid" },
        "version_number": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/course_status" },
        "title": { "$ref": "#/$defs/title" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "row_version": { "type": "integer", "minimum": 1 },
        "is_current_published": { "type": "boolean" }
      }
    },
    "CourseVersionHistoryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "course_id",
        "current_published_version_id",
        "versions",
        "next_cursor"
      ],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/uuid" },
        "course_id": { "$ref": "#/$defs/uuid" },
        "current_published_version_id": { "$ref": "#/$defs/nullable_uuid" },
        "versions": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/course_version_summary" }
        },
        "next_cursor": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 2048 },
            { "type": "null" }
          ]
        }
      }
    },
    "CreateSuccessorDraftV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_course_row_version",
        "expected_source_version_row_version",
        "expected_source_content_hash"
      ],
      "properties": {
        "expected_course_row_version": { "type": "integer", "minimum": 1 },
        "expected_source_version_row_version": {
          "type": "integer",
          "minimum": 1
        },
        "expected_source_content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "SuccessorDraftResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_version_id",
        "successor_version_id",
        "snapshot"
      ],
      "properties": {
        "source_version_id": { "$ref": "#/$defs/uuid" },
        "successor_version_id": { "$ref": "#/$defs/uuid" },
        "snapshot": { "$ref": "#/$defs/CourseSnapshotV1" }
      }
    }
  }
}
