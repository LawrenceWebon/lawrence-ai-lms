{
  "name": "ai-lms",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/web",
    "apps/e2e",
    "packages/api-client",
    "packages/test-data"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate:api": "node scripts/generate_openapi_client.mjs",
    "test:e2e": "npm run test:e2e --workspace @ai-lms/e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
